# --- Supabase (opcional) — Project Settings → API
# Sem estas duas variáveis o app roda em "modo demonstração" (dados só no navegador).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Defina "false" para esconder o botão "Criar conta" depois de cadastrar a equipe
NEXT_PUBLIC_ALLOW_SIGNUP=true
