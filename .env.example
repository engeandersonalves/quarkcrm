# --- Supabase (obrigatório) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role: usada só no servidor (resumo diário e destinatários dos alertas públicos). NUNCA exponha no front.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- URL pública do app (usada nos links dos e-mails)
NEXT_PUBLIC_APP_URL=https://seu-app.vercel.app

# --- E-mail (Resend — https://resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM="Quark CRM <alertas@seudominio.com.br>"
# Sempre recebem os alertas (além dos e-mails definidos em Configurações)
NOTIFY_EMAILS=voce@seudominio.com.br

# --- Resumo diário de tarefas (Vercel Cron)
CRON_SECRET=troque-por-um-valor-aleatorio
APP_TIMEZONE=America/Sao_Paulo

# Defina "false" para esconder o botão "Criar conta" no login depois de cadastrar a equipe
NEXT_PUBLIC_ALLOW_SIGNUP=true
